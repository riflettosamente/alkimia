# ============================================================================
# ALKIMIA — variabili d'ambiente
# Copia questo file in `.env` per lo sviluppo locale. Su Render vanno impostate
# nella scheda "Environment" del Web Service.
#
# La catena di generazione ha questa priorità:
#   1. OpenRouter   2. Cloudflare Workers AI   3. Google Gemini
# Un provider viene usato solo se TUTTE le sue variabili obbligatorie sono presenti.
# ============================================================================

# --- 1. OpenRouter (provider primario, modelli gratuiti) --------------------
# OBBLIGATORIO per usare OpenRouter. Senza questa chiave il provider viene saltato.
OPENROUTER_API_KEY=

# Opzionale — fissa il modello preferito, che viene tentato per primo.
# Se vuoto, la catena usa nell'ordine:
#   nex-agi/nex-n2.5-pro:free
#   nex-agi/nex-n2.5-mini:free
#   nvidia/nemotron-3.5-lightning:free
#   liquid/lfm-2.5-2.6b:free
# Per usare un modello A PAGAMENTO (es. meta-llama/llama-3.3-70b-instruct) serve
# credito sull'account OpenRouter, altrimenti risponde 402 Payment Required.
OPENROUTER_MODEL=

# Opzionale — intestazioni HTTP-Referer / X-Title richieste da OpenRouter.
APP_URL=https://alkimia.onrender.com

# --- 2. Cloudflare Workers AI (secondario) ----------------------------------
# Servono ENTRAMBI i valori, altrimenti il provider risulta "non configurato".
CLOUDFLARE_API_KEY=
# In alternativa a CLOUDFLARE_API_KEY è accettato anche CLOUDFLARE_API_TOKEN.
# CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct

# --- 3. Google Gemini (fallback finale, consuma token Google) ---------------
GEMINI_API_KEY=
# Opzionale — fissa il modello preferito. Default: gemini-3.6-flash, poi gemini-3.1-pro-preview.
GEMINI_MODEL=

# --- Runtime ----------------------------------------------------------------
# Su Render NON impostarla manualmente: la piattaforma inietta PORT da sola.
# In sviluppo locale, se assente, l'app usa la 3000.
# PORT=3000

# Da impostare a "production" solo nel comando di avvio del deploy.
# NODE_ENV=production

# Timeout per singola chiamata AI, in millisecondi (default 180000 = 3 minuti).
# Un saggio di 1.200–1.800 parole su modelli gratuiti richiede spesso più di 60 s.
AI_REQUEST_TIMEOUT_MS=180000

# Pausa minima tra due tentativi di rigenerazione dopo un fallimento (default 180000).
AI_RETRY_COOLDOWN_MS=180000

# Disabilita l'HMR di Vite (usato dall'ambiente AI Studio).
# DISABLE_HMR=true
